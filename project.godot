; Hat Düştü — Godot proje dosyası

config_version=5

[application]

config/name="Hat Düştü"
config/version="1.0.0"
run/main_scene="res://yukleyici.tscn"
config/icon="res://assets/ui/uretim/uygulama_ikonu.png"
boot_splash/image="res://assets/ui/uretim/acilis_splash.png"
boot_splash/bg_color=Color(0.0431, 0.0549, 0.0588, 1)
boot_splash/stretch_mode=1
boot_splash/show_image=true
config/features=PackedStringArray("4.7", "Mobile")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

occlusion_culling/use_occlusion_culling=true
reflections/reflection_atlas/reflection_count=4
renderer/rendering_method="mobile"
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true

[internationalization]

locale/translations=PackedStringArray("res://translations/en.po")
locale/fallback="tr"

[editor_plugins]

enabled=PackedStringArray("res://addons/GodotGooglePlayBilling/plugin.cfg")

[gui]

theme/custom_font="res://assets/fonts/metin.tres"

[audio]

driver/enable_input=true
general/ios/session_category=2

[physics]

common/max_physics_steps_per_frame=3
