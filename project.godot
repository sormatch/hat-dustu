; Hat Düştü — Godot proje dosyası

config_version=5

[application]

config/name="Hat Düştü"
config/version="1.0.0"
run/main_scene="res://main.tscn"
config/icon="res://assets/ui/uretim/uygulama_ikonu.png"
boot_splash/image="res://assets/ui/uretim/acilis_logolu.png"
boot_splash/bg_color=Color(0.02, 0.02, 0.03, 1)
boot_splash/stretch_mode=2
boot_splash/show_image=true
config/features=PackedStringArray("4.7", "Mobile")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true

[internationalization]

locale/translations=PackedStringArray("res://translations/en.po")
locale/fallback="tr"

[gui]

theme/custom_font="res://assets/fonts/metin.tres"

[audio]

driver/enable_input=true
general/ios/session_category=2
