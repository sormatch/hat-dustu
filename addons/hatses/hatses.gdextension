[configuration]

entry_symbol = "hatses_library_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]

windows.debug.x86_64 = "res://addons/hatses/bin/libhatses.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/hatses/bin/libhatses.windows.template_release.x86_64.dll"
android.debug.arm64 = "res://addons/hatses/bin/libhatses.android.template_debug.arm64.so"
android.release.arm64 = "res://addons/hatses/bin/libhatses.android.template_release.arm64.so"
ios.debug = "res://addons/hatses/bin/libhatses.ios.template_debug.xcframework"
ios.release = "res://addons/hatses/bin/libhatses.ios.template_release.xcframework"
