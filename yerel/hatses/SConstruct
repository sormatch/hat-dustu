#!/usr/bin/env python
# HatSes GDExtension (Opus + telefonun sesli görüşme yolu). Derleme: .github/workflows/hatses.yml
#   scons platform=<windows|android|ios> target=template_release arch=<x86_64|arm64> OPUS_DIR=<opus kurulumu>
# Çıktı: bin/ (Windows .dll, Android .so, iOS .a: iş akışı godot-cpp ve libopus ile birleştirip xcframework yapar)
import os

env = SConscript("godot-cpp/SConstruct")

opus = ARGUMENTS.get("OPUS_DIR", os.environ.get("OPUS_DIR", "opus_kur"))
e = env.Clone()
e.Append(CPPPATH=["src/", os.path.join(opus, "include", "opus")])
sources = Glob("src/*.cpp")
plat = e["platform"]

if plat == "ios":
    # arka_ios.cpp Objective-C++ (AVFoundation)
    e.Append(CCFLAGS=["-fobjc-arc", "-x", "objective-c++"])
    library = e.StaticLibrary("bin/libhatses.ios.{}.a".format(e["target"]), source=sources)
else:
    e.Append(LIBPATH=[os.path.join(opus, "lib")])
    e.Append(LIBS=["opus"])
    if plat == "android":
        e.Append(LIBS=["log", "dl"])
    library = e.SharedLibrary("bin/libhatses{}{}".format(e["suffix"], e["SHLIBSUFFIX"]), source=sources)

Default(library)
